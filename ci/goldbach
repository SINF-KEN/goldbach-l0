#!/usr/bin/env bash
# goldbach — the B580 campaign in one command.
#
#   goldbach          same as `goldbach up`
#   goldbach up       start everything: CI daemon, production, site sync (and keep it on at boot)
#   goldbach down     stop production at the end of the current slice (the CI daemon stays up)
#   goldbach status   what runs, progress, when the site last got data
#   goldbach logs     follow the production log
set -euo pipefail

ROOT=$HOME/coding/goldbach-l0
CI=(python3 "$ROOT/ci/goldbach_ci.py")
UNITS=(goldbach-ci.service goldbach-sync.timer goldbach-sync.path goldbach-campaign-queue.timer)

prod_log() {
    python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["journal"].replace(".journal", ".log"))' \
        "$ROOT/ci-state/production.json"
}

desired() {
    python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("desired", ""))' "$ROOT/ci-state/production.json"
}

range_active() {
    systemctl --user is-active --quiet goldbach-range.service
}

# Starts production unless it runs. `production start` takes ci.lock, which the
# CI daemon holds while it recovers or polls (and its recover() may be starting
# production itself right now): retry while the lock is busy, succeed if
# production came up either way, give up at once on any other error (e.g. a
# run_range FATAL: each attempt can wait 60 s for the resume line).
start_production() {
    local out
    for _ in $(seq 1 36); do
        range_active && return 0
        if out=$("${CI[@]}" production start 2>&1); then
            echo "$out"
            return 0
        fi
        range_active && return 0
        if ! grep -q 'is held by another process' <<<"$out"; then
            echo "  production did not start: $(tail -1 <<<"$out")" >&2
            return 1
        fi
        sleep 5
    done
    echo "  production did not start: ci.lock stayed busy for 3 min (a CI run? see goldbach_ci.py status)" >&2
    return 1
}

status() {
    for u in "${UNITS[@]}" goldbach-range.service; do
        printf '  %-32s %-9s %s\n' "$u" "$(systemctl --user is-active "$u" 2>/dev/null || true)" \
            "$(systemctl --user is-enabled "$u" 2>/dev/null || true)"
    done
    echo "  production desired: $(desired)"
    local log; log=$ROOT/$(prod_log)
    echo "  last slice: $(grep -E '^[0-9T:+-]+ (PASS|FAIL)' "$log" | tail -1 | cut -c1-160)"
    curl -fsS --max-time 10 https://goldbach.net01.io/api/results | python3 -c '
import json, sys, time
d = json.load(sys.stdin); b = d.get("backfill") or {}
age = (time.time() - d["paper"]["synced"]) / 60 if d.get("paper") else float("nan")
pct, eta = b.get("pct"), b.get("eta_days")
print(f"  site: data {age:.0f} min old" + (f", backfill {pct} %, ~{eta} days left" if b else ""))' \
        || echo "  site: not reachable"
}

case "${1:-up}" in
up)
    systemctl --user enable --now "${UNITS[@]}" 2>/dev/null
    # Whatever `desired` says: it stays "running" when production went down
    # without `goldbach down` (a failed CI resume, a cancelled job, a run_range
    # FATAL), and then nothing else restarts it (the daemon's recover() runs
    # only when the daemon starts, and never after a failure).
    start_production || true
    systemctl --user start goldbach-sync.service    # push to the site now
    status ;;
down)
    "${CI[@]}" production stop
    status ;;
status)
    status ;;
logs)
    tail -n 5 -F "$ROOT/$(prod_log)" ;;
*)
    sed -n '3,9p' "$0"; exit 2 ;;
esac
